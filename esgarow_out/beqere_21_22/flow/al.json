[
 {
  "t0": 0.13,
  "t1": 2.36,
  "rate": 2.69,
  "text": "Yə əyyuhən-naas"
 },
 {
  "t0": 3.04,
  "t1": 4.33,
  "rate": 3.11,
  "text": "Ey insanlar!"
 },
 {
  "t0": 5.05,
  "t1": 8.39,
  "rate": 5.08,
  "text": "Quranda Allah ilk dəfə bütün insanlığa üz tutur"
 },
 {
  "t0": 8.95,
  "t1": 9.89,
  "rate": 4.22,
  "text": "Və ilk sözü"
 },
 {
  "t0": 10.34,
  "t1": 11.11,
  "rate": 3.86,
  "text": "bir əmrdir"
 },
 {
  "t0": 11.76,
  "t1": 15.24,
  "rate": 5.17,
  "text": "Bu, Quranda bütün insanlara edilən ilk çağırışdır"
 },
 {
  "t0": 15.83,
  "t1": 22.52,
  "rate": 3.14,
  "text": "Yə əyyuhən-naasu'buduu rabbəkumulləzii xaləqakum"
 },
 {
  "t0": 22.88,
  "t1": 24.76,
  "rate": 4.77,
  "text": "vəlləziinə min qablikum"
 },
 {
  "t0": 25.35,
  "t1": 29.94,
  "rate": 1.74,
  "text": "ləalləkum təttəquun"
 },
 {
  "t0": 30.43,
  "t1": 36.38,
  "rate": 4.2,
  "text": "Əlləzii cəələ ləkumul-ərdə firaaşəv-vəs-səmaa-ə binaa-ə"
 },
 {
  "t0": 36.76,
  "t1": 41.48,
  "rate": 2.75,
  "text": "və ənzələ minəs-səmaai maa-ən"
 },
 {
  "t0": 42.02,
  "t1": 44.01,
  "rate": 9.03,
  "text": "fə-əxracə bihii minəs-saməraati rizqal-ləkum"
 },
 {
  "t0": 44.51,
  "t1": 48.19,
  "rate": 5.98,
  "text": "fəlaa təc'əluu lillaahi əndaadəv-və əntum tə'ləmuun"
 },
 {
  "t0": 48.5,
  "t1": 53.64,
  "rate": 7.19,
  "text": "Mənası: Ey insanlar! Sizi və sizdən əvvəlkiləri yaradan Rəbbinizə ibadət edin ki, təqvalı olasınız"
 },
 {
  "t0": 54.0,
  "t1": 57.84,
  "rate": 3.91,
  "text": "O Rəbb ki, yeri sizə döşək, göyü tavan etdi"
 },
 {
  "t0": 58.28,
  "t1": 62.83,
  "rate": 4.83,
  "text": "göydən su endirib onunla sizə ruzi olaraq meyvələr çıxartdı"
 },
 {
  "t0": 63.22,
  "t1": 65.22,
  "rate": 7.5,
  "text": "Elə isə bilə-bilə Allaha tay qoşmayın"
 },
 {
  "t0": 65.52,
  "t1": 66.73,
  "rate": 5.81,
  "text": "İndi gəl xırdalayaq"
 },
 {
  "t0": 67.06,
  "t1": 71.36,
  "rate": 5.34,
  "text": "Birinci incəlik: Allah burada Ey möminlər demir, Ey insanlar deyir"
 },
 {
  "t0": 71.58,
  "t1": 74.55,
  "rate": 5.05,
  "text": "Müsəlmana da, kafirə də, sənə də, mənə də"
 },
 {
  "t0": 74.99,
  "t1": 76.31,
  "rate": 7.57,
  "text": "Və ilk əmri ibadət edindir"
 },
 {
  "t0": 76.58,
  "t1": 80.4,
  "rate": 6.02,
  "text": "Amma əmr edib keçmir, dərhal səbəbini deyir: çünki sizi O yaradıb"
 },
 {
  "t0": 80.88,
  "t1": 84.06,
  "rate": 5.36,
  "text": "İkinci incəlik: Allah dəlil üçün uzağa getmir"
 },
 {
  "t0": 84.37,
  "t1": 90.41,
  "rate": 5.3,
  "text": "Ayağının altındakı yeri, başının üstündəki göyü, yağışı, süfrəndəki meyvəni göstərir"
 },
 {
  "t0": 90.82,
  "t1": 92.46,
  "rate": 6.11,
  "text": "Ənbiya surəsində buyurur"
 },
 {
  "t0": 92.8,
  "t1": 96.01,
  "rate": 4.67,
  "text": "Və cəalnəs-səmaa-ə saqfəm-məhfuuzaa"
 },
 {
  "t0": 96.4,
  "t1": 98.38,
  "rate": 5.05,
  "text": "Göyü qorunan bir tavan etdik"
 },
 {
  "t0": 98.76,
  "t1": 105.76,
  "rate": 5.43,
  "text": "Bu gün bilirik ki, atmosfer hər gün tonlarla kosmik daşı yandırıb kül edir, günəşin zərərli şüalarını saxlayır"
 },
 {
  "t0": 106.08,
  "t1": 109.33,
  "rate": 5.84,
  "text": "Başımızın üstündəki tavan bizi hər saniyə qoruyur"
 },
 {
  "t0": 109.85,
  "t1": 114.04,
  "rate": 5.72,
  "text": "Üçüncü incəlik isə ən incəsidir: Və əntum tə'ləmun, siz bilə-bilə"
 },
 {
  "t0": 114.42,
  "t1": 119.51,
  "rate": 4.32,
  "text": "Məkkə müşrikləri yeri-göyü Allahın yaratdığını bilirdilər"
 },
 {
  "t0": 119.86,
  "t1": 121.42,
  "rate": 5.78,
  "text": "Problem bilməməkdə deyildi"
 },
 {
  "t0": 121.79,
  "t1": 122.85,
  "rate": 5.67,
  "text": "tay qoşmaqda idi"
 },
 {
  "t0": 123.23,
  "t1": 129.83,
  "rate": 5.15,
  "text": "İbn Abbas deyir: bu tay qoşmaq, qaranlıq gecədə qara daşın üstündə gəzən qara qarışqadan da gizlidir"
 },
 {
  "t0": 130.3,
  "t1": 136.38,
  "rate": 5.27,
  "text": "Bir nəfər Peyğəmbərimizə, sallallahu aleyhi və səlləm, Allah və sən istədin deyəndə buyurdu"
 },
 {
  "t0": 136.78,
  "t1": 140.87,
  "rate": 4.15,
  "text": "Məni Allaha tay tutdunmu? De: Yalnız Allah istədi"
 },
 {
  "t0": 141.31,
  "t1": 141.86,
  "rate": 3.68,
  "text": "Bəs biz?"
 },
 {
  "t0": 142.4,
  "t1": 144.04,
  "rate": 5.48,
  "text": "Bu iş olmasa, ac qalaram"
 },
 {
  "t0": 144.56,
  "t1": 146.62,
  "rate": 5.35,
  "text": "Filankəs olmasa, heç nə alınmaz"
 },
 {
  "t0": 147.04,
  "t1": 150.62,
  "rate": 5.31,
  "text": "Ruzini yağışı endirəndən yox, başqasından gözləyirik"
 },
 {
  "t0": 151.12,
  "t1": 153.64,
  "rate": 4.77,
  "text": "Qəlbində Allaha tay tutduğun nə var?"
 },
 {
  "t0": 154.16,
  "t1": 156.4,
  "rate": 4.91,
  "text": "Allah bizi gizli şirkdən qorusun"
 },
 {
  "t0": 156.86,
  "t1": 159.05,
  "rate": 4.57,
  "text": "Şərhə Amin yazmağı unutma"
 },
 {
  "t0": 159.49,
  "t1": 165.06,
  "rate": 5.93,
  "text": "Növbəti videoda Quranın bütün insanlığa meydan oxuması: Onun bənzəri bir surə gətirin!"
 },
 {
  "t0": 165.59,
  "t1": 166.92,
  "rate": 6.75,
  "text": "Abunə olmağı unutma!"
 }
]