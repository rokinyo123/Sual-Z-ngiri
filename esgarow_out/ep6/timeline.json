[
 {
  "t0": 0,
  "t1": 4.16,
  "rate": 5.53,
  "text": "Quranın ilk surəsinin son ayəsi... həm də onun ən uzun ayəsidir."
 },
 {
  "t0": 4.43,
  "t1": 5.62,
  "rate": 4.21,
  "text": "Cəmi doqquz söz."
 },
 {
  "t0": 5.89,
  "t1": 8.18,
  "rate": 5.67,
  "text": "Bu doqquz sözün içində üç qrup insan var..."
 },
 {
  "t0": 8.45,
  "t1": 9.23,
  "rate": 6.4,
  "text": "sən hansındasan?"
 },
 {
  "t0": 9.51,
  "t1": 14.36,
  "rate": 4.95,
  "text": "Sıratəlləzinə ən'amtə aleyhim, ğayril-məğdubi aleyhim, vələd-dallin."
 },
 {
  "t0": 14.5,
  "t1": 17.46,
  "rate": 3.72,
  "text": "Nemət verdiyin kəslərin yoluna."
 },
 {
  "t0": 17.73,
  "t1": 21.47,
  "rate": 4.55,
  "text": "Qəzəbə uğrayanların və azanların yoluna yox."
 },
 {
  "t0": 21.75,
  "t1": 22.8,
  "rate": 3.8,
  "text": "Söz-söz baxaq."
 },
 {
  "t0": 23.08,
  "t1": 24.83,
  "rate": 6.29,
  "text": "Sırat, yol. Əlləzinə, o kəslər ki."
 },
 {
  "t0": 25.1,
  "t1": 26.83,
  "rate": 5.8,
  "text": "Ən'amtə, nemət verdin. Ğayr, deyil."
 },
 {
  "t0": 27.1,
  "t1": 30.36,
  "rate": 5.52,
  "text": "Əl-məğdub, qəzəbə uğrayan. Əd-dallin, yolunu azanlar."
 },
 {
  "t0": 30.64,
  "t1": 31.67,
  "rate": 3.88,
  "text": "Birinci sir."
 },
 {
  "t0": 31.94,
  "t1": 33.98,
  "rate": 3.93,
  "text": "Nemət verilənlər kimdir?"
 },
 {
  "t0": 34.25,
  "t1": 35.58,
  "rate": 6.02,
  "text": "Quran özü cavab verir."
 },
 {
  "t0": 35.85,
  "t1": 39.36,
  "rate": 3.99,
  "text": "Peyğəmbərlər, siddiqlər, şəhidlər və salehlər."
 },
 {
  "t0": 39.61,
  "t1": 42.13,
  "rate": 4.37,
  "text": "Və deyir: Onlar nə gözəl yoldaşdır."
 },
 {
  "t0": 42.4,
  "t1": 45.41,
  "rate": 5.31,
  "text": "Yəni bu duanı edəndə təkcə yol istəmirsən..."
 },
 {
  "t0": 45.57,
  "t1": 48.28,
  "rate": 3.33,
  "text": "yol yoldaşı da istəyirsən."
 },
 {
  "t0": 48.57,
  "t1": 50.51,
  "rate": 5.14,
  "text": "İkinci sir: sözlərin ədəbi."
 },
 {
  "t0": 50.8,
  "t1": 53.12,
  "rate": 5.16,
  "text": "Nemətdən danışanda deyir: ən'amtə..."
 },
 {
  "t0": 53.4,
  "t1": 54.08,
  "rate": 4.41,
  "text": "Sən verdin."
 },
 {
  "t0": 54.36,
  "t1": 57.26,
  "rate": 5.5,
  "text": "Amma qəzəbdən danışanda \"Sən qəzəbləndin\" demir."
 },
 {
  "t0": 57.53,
  "t1": 59.29,
  "rate": 5.68,
  "text": "Sadəcə: qəzəbə uğrayanlar."
 },
 {
  "t0": 59.57,
  "t1": 62.4,
  "rate": 5.66,
  "text": "Azanlar haqqında da belədir: Sən azdırdın demir."
 },
 {
  "t0": 62.69,
  "t1": 66.06,
  "rate": 6.53,
  "text": "Yaxşılığı Allaha bağla... dua edəndə belə ədəbi unutma."
 },
 {
  "t0": 66.33,
  "t1": 68.17,
  "rate": 4.89,
  "text": "Üçüncü sir: iki yanlış yol."
 },
 {
  "t0": 68.45,
  "t1": 72.04,
  "rate": 5.85,
  "text": "Alimlər deyir: qəzəbə uğrayan, haqqı bilib əməl etməyəndir."
 },
 {
  "t0": 72.32,
  "t1": 75.45,
  "rate": 5.11,
  "text": "Azan isə, əməl edən, amma bilmədən edəndir."
 },
 {
  "t0": 75.73,
  "t1": 77.08,
  "rate": 4.41,
  "text": "Biri bilir, etmir."
 },
 {
  "t0": 77.36,
  "t1": 78.76,
  "rate": 4.3,
  "text": "Biri edir, bilmir."
 },
 {
  "t0": 79.04,
  "t1": 82.72,
  "rate": 4.89,
  "text": "Doğru yol ikisinin birləşdiyi yerdir: bilmək və etmək."
 },
 {
  "t0": 82.99,
  "t1": 84.81,
  "rate": 5.48,
  "text": "Elmsiz ibadət yolu azdırar."
 },
 {
  "t0": 85.09,
  "t1": 87.81,
  "rate": 5.89,
  "text": "İbadətsiz elm isə insanı qəzəbə aparar."
 },
 {
  "t0": 88.08,
  "t1": 89.38,
  "rate": 3.85,
  "text": "Və sonda... Amin."
 },
 {
  "t0": 89.66,
  "t1": 91.09,
  "rate": 6.27,
  "text": "Amin Quranın sözü deyil."
 },
 {
  "t0": 91.36,
  "t1": 94.43,
  "rate": 6.53,
  "text": "Amma Peyğəmbərimiz, sallallahu aleyhi və səlləm, buyurdu:"
 },
 {
  "t0": 94.71,
  "t1": 97.38,
  "rate": 4.87,
  "text": "İmam amin deyəndə, siz də amin deyin."
 },
 {
  "t0": 97.66,
  "t1": 103.35,
  "rate": 4.74,
  "text": "Kimin amini mələklərin amininə uyğun gəlsə, keçmiş günahları bağışlanar."
 },
 {
  "t0": 103.63,
  "t1": 105.23,
  "rate": 6.85,
  "text": "Yeddi ayə... və hər biri bir sirdir."
 },
 {
  "t0": 105.51,
  "t1": 108.72,
  "rate": 4.35,
  "text": "Bəs səndə hansı çatışmır: bilmək, yoxsa etmək?"
 },
 {
  "t0": 109.01,
  "t1": 110.31,
  "rate": 4.62,
  "text": "Şərhdə bir sözlə yaz."
 },
 {
  "t0": 110.59,
  "t1": 111.42,
  "rate": 6.05,
  "text": "Fatihə bitdi."
 },
 {
  "t0": 111.7,
  "t1": 114.23,
  "rate": 4.74,
  "text": "Növbəti: Quranın ən böyük ayəsi..."
 },
 {
  "t0": 114.5,
  "t1": 115.79,
  "rate": 5.44,
  "text": "hansıdır, bilirsənmi?"
 },
 {
  "t0": 116.07,
  "t1": 117.39,
  "rate": 6.85,
  "text": "Abunə olmağı unutma."
 }
]